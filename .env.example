# ==========================================================
# StudyInstitution - Environment Configuration Example
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# ---------------- Application ----------------
APP_NAME=StudyInstitution
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-string

# ---------------- Database ----------------
DATABASE_URL=sqlite:///./data/studyinstitution.db

# ---------------- Keycloak ----------------
# For local development, use localhost. Docker Compose overrides this to the
# internal service name 'keycloak' for the backend container.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=study-institution
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# Backend (confidential) client used by FastAPI to talk to Keycloak
KEYCLOAK_BACKEND_CLIENT_ID=study-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-this-client-secret

# Frontend (public) client used by browser / mobile apps to log in
KEYCLOAK_FRONTEND_CLIENT_ID=study-frontend

# Role names expected inside the realm
KEYCLOAK_STUDENT_ROLE=student
KEYCLOAK_ADMIN_ROLE=super_admin
KEYCLOAK_INSTITUTION_ADMIN_ROLE=institution_admin
KEYCLOAK_PROFESSOR_ROLE=professor

# Default users created by keycloak_setup.py automation (dev/demo only)
DEFAULT_ADMIN_USERNAME=admin@studyinstitution.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_STUDENT_USERNAME=student@studyinstitution.com
DEFAULT_STUDENT_PASSWORD=Student@12345

# If true, the API will skip live Keycloak signature verification and
# accept the "dev" HS256 test tokens produced by tests / local tooling.
# ALWAYS false in production.
AUTH_DEV_MODE=false
